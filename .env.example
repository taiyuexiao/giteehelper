PORT=8787
DATABASE_PATH=./data/giteehelper.db
GITEE_API_BASE=https://gitee.com/api/v5
GITEE_TOKEN=
GITEE_WEBHOOK_SECRET=
GITEE_REPO=
GITEE_DEFAULT_BRANCH=main
FEISHU_WEBHOOK_URL=
# 可选：OpenAI 兼容的大模型服务，为飞书卡片生成「概要」。不配置时卡片不带概要，不影响通知。
# 示例（智谱 GLM）：LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=glm-4-flash
# 通知里给出的控制台链接前缀，例如 http://your-host/giteehelper（当前通知不再使用，保留备用）
PUBLIC_BASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
